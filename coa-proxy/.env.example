APP_ENV=production
APP_DEBUG=false

# CoA Proxy API Bearer Token (Minimum 32 characters recommended)
COA_API_TOKEN=CHANGE_ME_SUPER_SECRET_BEARER_TOKEN_32CHARS

# Allowed Client IP Addresses (Comma-separated, e.g. Laravel Billing Server IP)
COA_ALLOWED_IPS=127.0.0.1,10.10.10.20

# RADIUS NAS Settings
RADIUS_DEFAULT_NAS=10.10.10.1
RADIUS_ALLOWED_NAS=10.10.10.1,10.10.10.2,10.10.10.3
RADIUS_COA_PORT=3799
RADIUS_SECRET=CHANGE_ME_RADIUS_SHARED_SECRET

# Executable Paths & Timeouts
RADCLIENT_PATH=/usr/bin/radclient
RADIUS_TIMEOUT=5

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/www/coa-proxy/storage/logs/coa.log
