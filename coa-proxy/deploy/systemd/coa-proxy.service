[Unit]
Description=FreeRADIUS CoA Proxy Log Rotator and Storage Maintenance Service
After=network.target php8.3-fpm.service

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/find /var/www/coa-proxy/storage/idempotency /var/www/coa-proxy/storage/cache -type f -mmin +10 -delete
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
